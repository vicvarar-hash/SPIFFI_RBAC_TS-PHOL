# LLM provider API keys. Copy this file to `.env` and paste your rotated keys.
# `.env` is gitignored — never commit real keys.
#
# Only the keys for providers you actually use are required.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Azure AI Foundry (deployments: gpt-4o, gpt-5.4, gpt-35-turbo-16k)
# Endpoint is the bare resource base URL, e.g. https://<resource>.cognitiveservices.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
# Optional; defaults to a recent GA value if unset.
AZURE_FOUNDRY_API_VERSION=

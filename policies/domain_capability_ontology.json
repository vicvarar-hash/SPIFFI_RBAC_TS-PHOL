{
  "_comment": "TS-PHOL capability ontology. Each domain has ONE core (read) capability; two task-intents need a more specific capability (the only overrides that ever fire-and-differ). capability_implications encode subsumption: a more powerful capability implies the weaker ones it can perform (e.g. a write implies the corresponding read).",
  "domain_capabilities": {
    "Atlassian": {
      "IssueCreation": { "hard": ["IssueCreation"], "required": ["IssueCreation"], "soft": [], "optional": [] }
    },
    "Grafana": {
      "AlertAudit": { "hard": ["AlertRuleReview"], "required": ["AlertRuleReview"], "soft": [], "optional": [] }
    }
  },
  "abstract_capabilities": [
    "AtlassianRead",
    "AtlassianWrite",
    "DevOpsRead",
    "DevOpsWrite",
    "FinanceRead",
    "FinanceWrite",
    "GenericRead",
    "GenericWrite",
    "HummingbotRead",
    "HummingbotWrite",
    "ObservabilityRead",
    "ObservabilityWrite"
  ],
  "capability_implications": {
    "IssueUpdate": ["IssueRead"],
    "IssueCreation": ["IssueRead"],
    "IssueSearch": ["IssueRead"],
    "WorkflowTransition": ["IssueRead", "IssueUpdate"],
    "HistoryReview": ["IssueRead"],
    "FinancialWrite": ["FinancialRead"],
    "SubscriptionUpdate": ["FinancialRead", "FinancialWrite"],
    "UpdateSubscription": ["FinancialRead", "FinancialWrite"],
    "ObservabilityRead": ["AlertRuleReview", "DatasourceReview", "MetricsQuery"],
    "LogAnalysis": ["LogQuery"],
    "DashboardInspection": ["DatasourceReview"],
    "IncidentCorrelation": ["AlertRuleReview", "MetricsQuery"],
    "IncidentAnnotation": ["IncidentCorrelation", "InvestigationLookup"],
    "InvestigationLookup": ["AlertRuleReview"],
    "IncidentCreation": ["IncidentCorrelation"],
    "OncallScheduleReview": ["OncallUserInspection"],
    "ProfilingAnalysis": ["MetricsQuery"],
    "CloudResourceWrite": ["CloudResourceRead"],
    "CloudMonitoring": ["CloudResourceRead"],
    "NotionWrite": ["NotionRead"],
    "QueryAnalysis": ["CollectionScan"],
    "IndexReview": ["CollectionScan"],
    "PerformanceAudit": ["CollectionScan"]
  },
  "domain_fallbacks": {
    "Atlassian":  { "hard": ["IssueRead"],          "required": ["IssueRead"],          "soft": [], "optional": [] },
    "Grafana":    { "hard": ["MetricsQuery"],        "required": ["MetricsQuery"],        "soft": [], "optional": [] },
    "Stripe":     { "hard": ["FinancialRead"],       "required": ["FinancialRead"],       "soft": [], "optional": [] },
    "MongoDB":    { "hard": ["CollectionScan"],      "required": ["CollectionScan"],      "soft": [], "optional": [] },
    "Azure":      { "hard": ["CloudResourceRead"],   "required": ["CloudResourceRead"],   "soft": [], "optional": [] },
    "Notion":     { "hard": ["NotionRead"],          "required": ["NotionRead"],          "soft": [], "optional": [] },
    "Wikipedia":  { "hard": ["KnowledgeSearch"],     "required": ["KnowledgeSearch"],     "soft": [], "optional": [] },
    "Hummingbot": { "hard": ["MarketDataAnalysis"],  "required": ["MarketDataAnalysis"],  "soft": [], "optional": [] }
  }
}
